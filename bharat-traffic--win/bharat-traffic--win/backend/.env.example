[TEMPLATE]
# Application
APP_NAME=BharatTrafficTwin
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/bharat_traffic_twin

# SUMO
SUMO_HOME=/usr/share/sumo

# JWT auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# HERE Maps API (traffic + routing — get from https://developer.here.com)
# Both keys can be the same; HERE_API_KEY is used for Traffic Flow v7
# HERE_API_KEY_V8 is used for Routing v8 (falls back to HERE_API_KEY)
HERE_API_KEY=
HERE_API_KEY_V8=
