# Bharat Traffic Twin Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WEBSOCKET_URL=ws://localhost:8000/ws

# Map Tile URLs — override individually or set CARTO key to remove watermark.
# Free CARTO API key (no credit card): https://app.carto.com
VITE_CARTO_API_KEY=
# VITE_MAP_DARK_URL=https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png?api_key=YOUR_KEY
# VITE_MAP_SATELLITE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# VITE_MAP_TRAFFIC_URL=https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?api_key=YOUR_KEY
# VITE_MAP_STREETS_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Map API (OpenStreetMap - free, no API key needed)
VITE_NOMINATIM_BASE=https://nominatim.openstreetmap.org
VITE_OVERPASS_BASE=https://overpass-api.de/api/interpreter
